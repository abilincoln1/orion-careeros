# --- Application ---
APP_NAME=CareerOS (Project ORION)
APP_VERSION=0.1.0-sprint1
ENVIRONMENT=development
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (docker-compose service name = "db") ---
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros
POSTGRES_DB=careeros
DATABASE_URL=postgresql+asyncpg://careeros:careeros@db:5432/careeros
DATABASE_URL_SYNC=postgresql+psycopg2://careeros:careeros@db:5432/careeros
DB_ECHO=false

# --- Host port overrides ---
# This machine may run more than one ORION product (or other Docker
# projects, e.g. NDIP) at the same time. If a default port below is
# already taken by another project, override it here -- the container-
# internal ports never change, only how they're published to the host.
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=5173

# --- Auth ---
# IMPORTANT: generate a real secret before any non-local use:
#   openssl rand -hex 32
SECRET_KEY=CHANGE_ME_replace_with_output_of_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
