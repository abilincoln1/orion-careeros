# Backend-local override file (optional). The canonical example lives in
# the repo root .env.example; this file exists so `backend/` is runnable
# standalone (e.g. outside Docker) during development.
DATABASE_URL=postgresql+asyncpg://careeros:careeros@localhost:5432/careeros
DATABASE_URL_SYNC=postgresql+psycopg2://careeros:careeros@localhost:5432/careeros
SECRET_KEY=CHANGE_ME_local_dev_only
LOG_JSON=false
DEBUG=true
